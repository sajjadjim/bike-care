# ==========================================
# MotoCare — Environment Variables Example
# ==========================================

# 1. MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://motocare_admin:your_secure_password@cluster0.abcde.mongodb.net/motocare?retryWrites=true&w=majority

# 2. Firebase Authentication (Client-side)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=motocare-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=motocare-saas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=motocare-saas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef

# 3. Firebase Admin SDK (Server-side token verification)
FIREBASE_PROJECT_ID=motocare-saas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@motocare-saas.iam.gserviceaccount.com
# Use standard newlines or \n in quotes for private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# 4. Regional Defaults
NEXT_PUBLIC_DEFAULT_CURRENCY=BDT
NEXT_PUBLIC_CURRENCY_SYMBOL=৳
NEXT_PUBLIC_TIMEZONE=Asia/Dhaka
NEXT_PUBLIC_DISTANCE_UNIT=Kilometers
